{
  "schema": 1,
  "id": "life",
  "title": "刘备 · 这一局",
  "bind": ".sanguo/life.json",
  "staleAfter": 86400,
  "blocks": [
    { "type": "metric", "label": "年月", "value": "{{when}}" },
    { "type": "metric", "label": "年龄", "value": "{{age}}", "unit": "岁" },
    { "type": "metric", "label": "所在", "value": "{{place}}" },
    {
      "type": "progress",
      "label": "名望",
      "value": "{{counters.fame}}",
      "max": 100
    },
    {
      "type": "progress",
      "label": "信义",
      "value": "{{counters.trust}}",
      "max": 100
    },
    {
      "type": "progress",
      "label": "人才",
      "value": "{{counters.talent}}",
      "max": 100
    },
    { "type": "metric", "label": "兵力", "value": "{{resources.troops}}" },
    { "type": "metric", "label": "天下", "value": "{{world.mood}}" },
    {
      "type": "list",
      "label": "相关的人",
      "bind": "/people",
      "item": { "title": "{{name}}", "detail": "{{stance}}" }
    },
    {
      "type": "actions",
      "items": [
        { "label": "继续", "prompt": "继续" },
        { "label": "我走到哪了", "prompt": "我走到哪了" },
        { "label": "等一等", "prompt": "我什么都不做，等一等" }
      ]
    }
  ]
}
