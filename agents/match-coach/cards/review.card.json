{
  "schema": 1,
  "id": "review",
  "title": "上一局",
  "bind": "data/latest.json",
  "staleAfter": 604800,
  "blocks": [
    { "type": "metric", "label": "英雄", "value": "{{hero}}" },
    { "type": "metric", "label": "KDA", "value": "{{kda}}" },
    { "type": "markdown", "value": "{{verdict}}" },
    { "type": "metric", "label": "下一局只改", "value": "{{fix}}" },
    {
      "type": "actions",
      "items": [
        { "label": "再复盘一局", "prompt": "复盘这一局" },
        { "label": "看版本要点", "prompt": "这版本改了什么" }
      ]
    }
  ]
}
