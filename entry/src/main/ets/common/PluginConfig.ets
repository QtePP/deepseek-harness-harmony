import { common } from '@kit.AbilityKit'
import { preferences } from '@kit.ArkData'
import { fileIo as fs } from '@kit.CoreFileKit'

/**
 * User capability toggles (the Settings "dsh 能力开关" section).
 *
 * Choices persist in preferences and materialise as `patches/user.patch.yml`
 * under filesDir. NodeHost hands that path to bootstrap through
 * DSH_USER_PATCH_FILE, and bootstrap appends a second `--patch` after the
 * platform patch — dsh composes later rows on top of earlier ones, so the
 * user file only needs rows that differ from the platform defaults.
 *
 * node::Start runs once per process, so a change takes effect after the app
 * is fully restarted; the UI notes this at the toggle site.
 */
export class PluginConfig {
  private static readonly STORE = 'dsh_plugins'
  private static readonly KEY = 'disabled_ids'
  private static store: preferences.Preferences | null = null

  /** Entry ids the user switched off; empty means "platform defaults". */
  static disabled: Set<string> = new Set<string>()

  static async load(context: common.UIAbilityContext): Promise<void> {
    PluginConfig.store = await preferences.getPreferences(context, PluginConfig.STORE)
    const raw = await PluginConfig.store.get(PluginConfig.KEY, '') as string
    const ids = new Set<string>()
    const parts = raw.split(',')
    for (const part of parts) {
      const id = part.trim()
      if (id.length > 0) {
        ids.add(id)
      }
    }
    PluginConfig.disabled = ids
    PluginConfig.applyPatch(context)
  }

  static async setDisabled(context: common.UIAbilityContext, id: string, disabled: boolean): Promise<void> {
    if (disabled) {
      PluginConfig.disabled.add(id)
    } else {
      PluginConfig.disabled.delete(id)
    }
    if (PluginConfig.store === null) {
      PluginConfig.store = await preferences.getPreferences(context, PluginConfig.STORE)
    }
    await PluginConfig.store.put(PluginConfig.KEY, PluginConfig.joinIds())
    await PluginConfig.store.flush()
    PluginConfig.applyPatch(context)
  }

  private static joinIds(): string {
    const ids: string[] = []
    PluginConfig.disabled.forEach((id: string) => {
      ids.push(id)
    })
    return ids.join(',')
  }

  /** Write user.patch.yml; remove it when nothing is disabled. */
  static applyPatch(context: common.UIAbilityContext): void {
    const dir = `${context.filesDir}/patches`
    const file = `${dir}/user.patch.yml`
    try {
      const ids: string[] = []
      PluginConfig.disabled.forEach((id: string) => {
        ids.push(id)
      })
      if (ids.length === 0) {
        if (fs.accessSync(file)) {
          fs.unlinkSync(file)
        }
        return
      }
      if (!fs.accessSync(dir)) {
        fs.mkdirSync(dir)
      }
      const lines: string[] = ['# Generated by dshharmony Settings; applied as the second --patch.']
      for (const id of ids) {
        lines.push(`- id: ${id}`)
        lines.push('  disabled: true')
        lines.push('')
      }
      const out = fs.openSync(file, fs.OpenMode.CREATE | fs.OpenMode.READ_WRITE | fs.OpenMode.TRUNC)
      fs.writeSync(out.fd, lines.join('\n'))
      fs.closeSync(out)
    } catch (error) {
      console.error(`plugin patch write failed: ${(error as Error).message}`)
    }
  }
}
